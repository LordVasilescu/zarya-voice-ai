# Discord bot token for the Zarya bot
DISCORD_TOKEN=
# Claude CLI model alias used as the "brain" (e.g. sonnet, haiku)
ZARYA_MODEL=
# Folder for consented transcript logs (defaults to ./voicelog)
ZARYA_MEMORY_DIR=
# 1 = also keep raw utterance audio (off by default)
ZARYA_KEEP_AUDIO=
# Voice server endpoints (default http://127.0.0.1:8765/stt and /tts)
ZARYA_STT_URL=
ZARYA_TTS_URL=
